[
  {
    "id": "rfid_inventory_tab",
    "type": "tab",
    "label": "RFID Inventory",
    "disabled": false,
    "info": "IoT-Based Smart Inventory Management System\nFRDM-MCXW71 + RC522 RFID + BLE"
  },
  {
    "id": "mqtt_in_update",
    "type": "mqtt in",
    "z": "rfid_inventory_tab",
    "name": "BLE Inventory Updates",
    "topic": "inventory/update/json",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "x": 160,
    "y": 120,
    "wires": [["parse_update"]]
  },
  {
    "id": "mqtt_in_status",
    "type": "mqtt in",
    "z": "rfid_inventory_tab",
    "name": "Inventory Status",
    "topic": "inventory/status/json",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "x": 160,
    "y": 220,
    "wires": [["parse_status"]]
  },
  {
    "id": "mqtt_in_log",
    "type": "mqtt in",
    "z": "rfid_inventory_tab",
    "name": "Alerts & Logs",
    "topic": "inventory/log",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt_broker_local",
    "x": 160,
    "y": 320,
    "wires": [["alert_text"]]
  },
  {
    "id": "parse_update",
    "type": "function",
    "z": "rfid_inventory_tab",
    "name": "Parse Update",
    "func": "var payload = msg.payload;\nvar action  = payload.action   || 'N/A';\nvar product = payload.product  || 'Unknown';\nvar qty     = payload.quantity !== undefined ? payload.quantity : 0;\nvar ts      = payload.timestamp || new Date().toISOString();\n\n// Route to correct product gauge\nmsg.topic   = product;\nmsg.payload = qty;\nmsg.action  = action;\nmsg.ts      = ts;\n\n// Set dashboard text\nmsg.text    = `[${ts.substring(11,19)}] ${action}: ${product} → Stock: ${qty}`;\n\nreturn msg;",
    "outputs": 1,
    "x": 420,
    "y": 120,
    "wires": [["product_gauge", "event_log_text"]]
  },
  {
    "id": "parse_status",
    "type": "function",
    "z": "rfid_inventory_tab",
    "name": "Parse Status",
    "func": "var inv = msg.payload.inventory || {};\n// Build a table string for display\nvar lines = Object.entries(inv)\n    .map(([k,v]) => `${k}: ${v}`)\n    .join('\\n');\nmsg.payload = lines;\nreturn msg;",
    "outputs": 1,
    "x": 420,
    "y": 220,
    "wires": [["status_text"]]
  },
  {
    "id": "alert_text",
    "type": "function",
    "z": "rfid_inventory_tab",
    "name": "Format Alert",
    "func": "var t = new Date().toISOString().substring(11,19);\nmsg.payload = `[${t}] ${msg.payload}`;\nreturn msg;",
    "outputs": 1,
    "x": 420,
    "y": 320,
    "wires": [["alerts_ui"]]
  },
  {
    "id": "product_gauge",
    "type": "ui_gauge",
    "z": "rfid_inventory_tab",
    "name": "Stock Level",
    "group": "inventory_group",
    "order": 1,
    "width": "6",
    "height": "4",
    "gtype": "gage",
    "title": "Stock Level (last scanned)",
    "label": "units",
    "format": "{{value}}",
    "min": "0",
    "max": "50",
    "colors": ["#ff0000", "#ffff00", "#00b500"],
    "seg1": "10",
    "seg2": "25",
    "x": 680,
    "y": 120,
    "wires": []
  },
  {
    "id": "event_log_text",
    "type": "ui_text",
    "z": "rfid_inventory_tab",
    "group": "inventory_group",
    "order": 2,
    "width": "6",
    "height": "1",
    "name": "Last Event",
    "label": "Last Scan",
    "format": "{{msg.text}}",
    "layout": "row-spread",
    "x": 680,
    "y": 180,
    "wires": []
  },
  {
    "id": "status_text",
    "type": "ui_text",
    "z": "rfid_inventory_tab",
    "group": "inventory_group",
    "order": 3,
    "width": "6",
    "height": "4",
    "name": "Stock Status",
    "label": "Current Inventory",
    "format": "<pre>{{msg.payload}}</pre>",
    "layout": "row-spread",
    "x": 680,
    "y": 220,
    "wires": []
  },
  {
    "id": "alerts_ui",
    "type": "ui_text",
    "z": "rfid_inventory_tab",
    "group": "inventory_group",
    "order": 4,
    "width": "6",
    "height": "2",
    "name": "Alerts",
    "label": "System Alerts",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 680,
    "y": 320,
    "wires": []
  },
  {
    "id": "inventory_group",
    "type": "ui_group",
    "name": "RFID Inventory Dashboard",
    "tab": "inventory_ui_tab",
    "order": 1,
    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "inventory_ui_tab",
    "type": "ui_tab",
    "name": "Inventory",
    "icon": "dashboard",
    "disabled": false,
    "hidden": false
  },
  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "node-red-rfid",
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoConnect": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  }
]
